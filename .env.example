# Configuration examples only. Never commit real credentials; copy this file
# to .env (or export the variables) and fill in values.

# LLM provider for both baseline and RepoGuard (docs/baseline.md):
#   mock (default) | openai-compatible
REPOGUARD_LLM_PROVIDER=openai-compatible

# Generic chat-completions endpoint. For Google Gemini's OpenAI-compatible
# layer use: https://generativelanguage.googleapis.com/v1beta/openai
REPOGUARD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model id, e.g. gemini-2.5-pro (also accepted via the --model flag).
REPOGUARD_LLM_MODEL=gemini-2.5-pro

# API key. Precedence:
#   1. REPOGUARD_LLM_API_KEY
#   2. OPENROUTER_API_KEY (OpenRouter endpoints)
#   3. GEMINI_API_KEY (Google's conventional name)
# Used only for the Authorization header; never recorded in result artifacts.
REPOGUARD_LLM_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional outbound HTTP timeout in seconds (default 60).
REPOGUARD_LLM_TIMEOUT_S=600